# ─────────────────────────────────────────────────────────────────────────────
# Sympho Build — website environment
# Copy to `.env` for local development and set the same keys in Vercel/Netlify.
# Every variable is optional: with no Sanity project ID the site runs in DEMO
# MODE, serving the bundled seed content (src/lib/server/demo/seed).
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash) — used for canonical URLs, sitemap and Open Graph.
PUBLIC_SITE_URL=http://localhost:5173

# Sanity project (public — safe in the browser; needed to build image URLs)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-09-01

# Optional read token (Viewer). Only needed for a private dataset.
SANITY_API_READ_TOKEN=

# Write token (Editor) — SERVER ONLY. Lets the enquiry forms create `lead` documents.
# Never prefix with PUBLIC_. Without it, forms still validate but leads are only logged.
SANITY_API_WRITE_TOKEN=

# Optional: POST a JSON summary of every new lead to a webhook (Slack, Zapier, Make…).
LEAD_NOTIFY_WEBHOOK_URL=
