{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "**/*.tsx", "../src/lib/icon-names.ts"],
	"exclude": ["node_modules", "dist", "seed/*.ndjson"]
}
