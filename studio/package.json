		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sanity": "^6.16.0",
		"styled-components": "^6.5.3"
	},
	"devDependencies": {
		"@types/node": "^24.13.6",
		"@types/react": "^19.3.0",
		"typescript": "^6.0.3"
	}
}
